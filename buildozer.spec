
[app]

# (str) Title of your application
title = CricketScorer

# (str) Package name
package.name = cricketscorer

# (str) Package domain
package.domain = org.cricketscorer

# (str) Source directory
source.dir = .

# (str) Main Python file
source.main = cricketscorer.py

# (str) Application version
version = 1.0

# (list) Python files and other files to include
source.include_exts = py,png,jpg,jpeg,kv,atlas

# (str) Application requirements
requirements = python3,kivy

# (str) Orientation
orientation = portrait

# (bool) Fullscreen
fullscreen = 0


[buildozer]

# (str) Log level
log_level = 2

# (str) Warning when running as root
warn_on_root = 1
